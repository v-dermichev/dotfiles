{
  "permissions": {
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nvim-checktime.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "model": "claude-fable-5[1m]"
}
