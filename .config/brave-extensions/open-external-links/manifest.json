{
  "manifest_version": 3,
  "name": "Open External Links",
  "version": "1.1",
  "description": "Opens external links via xdg-open instead of current profile",
  "permissions": ["nativeMessaging", "tabs"],
  "content_scripts": [
    {
      "matches": ["https://messenger.360.yandex.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
