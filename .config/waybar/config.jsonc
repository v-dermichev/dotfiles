{
    "layer": "top",
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces", 
        "custom/layout", 
        "custom/hypr-split"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/notification-sound",
        "bluetooth",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "hyprland/language",
        "battery",
        "clock",
        "tray",
        "custom/power"
    ],
    "hyprland/workspaces": {},
    "hyprland/window": {
        "max-length": 50
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-connected": "󰂱 {device_alias}",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wofi --show dmenu <<< $'Shutdown\\nReboot\\nSuspend' | xargs -I {} bash -c 'case {} in Shutdown) loginctl poweroff;; Reboot) loginctl reboot;; Suspend) loginctl suspend;; esac'"
    },
    "custom/layout": {
        "exec": "hyprctl getoption general:layout -j | jq -r '.str'",
        "interval": 2,
        "on-click": "hyprctl keyword general:layout \"$([ \"$(hyprctl getoption general:layout -j | jq -r '.str')\" = \"dwindle\" ] && echo master || echo dwindle)\"",
        "format": "{}",
        "tooltip-format": "Click to toggle layout"
    },
    "custom/notification-sound": {
        "exec": "if [ -f /tmp/notification-sound-enabled ] && [ \"$(cat /tmp/notification-sound-enabled)\" = \"1\" ]; then echo '{\"text\": \"󰂚\", \"tooltip\": \"Notification sounds: ON\", \"class\": \"on\"}'; else echo '{\"text\": \"󰂛\", \"tooltip\": \"Notification sounds: OFF\", \"class\": \"off\"}'; fi",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "if [ \"$(cat /tmp/notification-sound-enabled)\" = \"1\" ]; then echo 0 > /tmp/notification-sound-enabled; else echo 1 > /tmp/notification-sound-enabled; fi; pkill -RTMIN+9 waybar"
    },
    "custom/hypr-split": {
      "exec": "~/.config/waybar/scripts/hypr-split-status.sh",
      "return-type": "json",
      "interval": "once",
      "signal": 8,  // RTMIN+8 triggers a refresh
      "on-click": "~/.config/waybar/scripts/hypr-split-toggle.sh"
    }
}
