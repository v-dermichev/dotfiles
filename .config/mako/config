font=JetBrainsMono Nerd Font, Noto Color Emoji 11
background-color=#2b303bCC
text-color=#ffffff
border-color=#64727DCC
border-size=2
border-radius=10
padding=12
margin=10
width=350
height=150
max-visible=3
default-timeout=5000
icons=1
max-icon-size=48
icon-border-radius=5
layer=overlay
anchor=top-right
on-notify=exec canberra-gtk-play -i complete
[app-name="Telegram Desktop"]
on-button-left=exec hyprctl dispatch togglespecialworkspace telegram; makoctl dismiss -n "$id"

[body~="messenger.360.yandex.com"]
on-button-left=exec hyprctl dispatch togglespecialworkspace messenger; makoctl dismiss -n "$id"

[urgency=low]
background-color=#2b303bAA
border-color=#64727DAA

[urgency=high]
background-color=#f53c3c66
border-color=#f53c3cCC
default-timeout=10000

[mode=silent]
on-notify=none

[mode=do-not-disturb]
invisible=1
on-notify=none
